# Sleepless Café — repo ignore rules

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*~

# Local scratch / test artifacts
_tmp_*
*.log

# Local environments / build outputs
.venv/
venv/
node_modules/
__pycache__/
*.pyc

# Never commit a real secret key even if one is ever dropped in here
*secret*key*
